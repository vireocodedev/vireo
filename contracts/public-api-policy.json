{
  "schemaVersion": 1,
  "npm": {
    "create-vireo": {
      "role": "project-scaffolder",
      "entryPoints": {
        ".": { "audience": "authoring-tooling", "environment": ["node"] }
      }
    },
    "@vireocodedev/history": {
      "role": "history-domain",
      "entryPoints": {
        ".": { "audience": "application", "environment": ["browser", "worker"] }
      }
    },
    "@vireocodedev/infrastructure": {
      "role": "browser-infrastructure",
      "entryPoints": {
        ".": { "audience": "application", "environment": ["browser"] },
        "./network-status": { "audience": "application", "environment": ["browser", "worker"] },
        "./pagination": { "audience": "application", "environment": ["browser", "worker"] }
      }
    },
    "@vireocodedev/localization": {
      "role": "localization-resources",
      "entryPoints": {
        ".": { "audience": "application", "environment": ["browser", "worker"] }
      }
    },
    "@vireocodedev/query": {
      "role": "query-contracts",
      "entryPoints": {
        ".": { "audience": "application", "environment": ["browser", "worker"] }
      }
    },
    "@vireocodedev/shell": {
      "role": "application-shell-contracts",
      "entryPoints": {
        ".": { "audience": "application", "environment": ["browser", "worker"] }
      }
    },
    "@vireocodedev/sqlite": {
      "role": "offline-persistence",
      "entryPoints": {
        ".": { "audience": "application", "environment": ["browser", "worker"] },
        "./offline": { "audience": "application", "environment": ["browser", "worker"] }
      }
    },
    "@vireocodedev/ui": {
      "role": "react-design-system",
      "entryPoints": {
        ".": {
          "audience": "application",
          "environment": ["browser"],
          "symbolBudget": 765,
          "disposition": "freeze-growth",
          "stability": "supported",
          "guidance": "Default application entry point for Vireo components, hooks, providers, and layout contracts."
        },
        "./country": {
          "audience": "application",
          "environment": ["browser"],
          "symbolBudget": 21,
          "disposition": "retain",
          "stability": "supported",
          "guidance": "Focused country-code, country-name, and country-flag surface."
        },
        "./event-source": {
          "audience": "application",
          "environment": ["browser"],
          "symbolBudget": 7,
          "disposition": "retain",
          "stability": "advanced",
          "guidance": "Opt-in browser EventSource integration for applications that own reconnect and authorization policy."
        },
        "./forms": {
          "audience": "application",
          "environment": ["browser"],
          "symbolBudget": 551,
          "disposition": "freeze-growth",
          "stability": "supported",
          "guidance": "Canonical TanStack Form bindings and Vireo form components; prefer this subpath for form-only consumers."
        },
        "./hello-pangea-dnd": {
          "audience": "optional-integration",
          "environment": ["browser"],
          "symbolBudget": 56,
          "disposition": "retain",
          "stability": "advanced",
          "guidance": "Typed passthrough for applications that deliberately adopt the optional drag-and-drop peer."
        },
        "./localization": {
          "audience": "optional-integration",
          "environment": ["browser"],
          "symbolBudget": 5,
          "disposition": "retain",
          "stability": "supported",
          "guidance": "Required localization boundary for Vireo temporal form fields."
        },
        "./react-i18next": {
          "audience": "optional-integration",
          "environment": ["browser"],
          "symbolBudget": 3,
          "disposition": "retain",
          "stability": "advanced",
          "guidance": "Narrow namespace-bound helpers for applications already using react-i18next."
        },
        "./sonner": {
          "audience": "optional-integration",
          "environment": ["browser"],
          "symbolBudget": 19,
          "disposition": "retain",
          "stability": "advanced",
          "guidance": "Notification integration for applications that deliberately adopt the optional Sonner peer."
        },
        "./tanstack-query": {
          "audience": "optional-integration",
          "environment": ["browser"],
          "symbolBudget": 30,
          "disposition": "retain",
          "stability": "advanced",
          "guidance": "Query-boundary and mutation helpers for applications that own a TanStack Query client."
        },
        "./theme": {
          "audience": "application",
          "environment": ["browser"],
          "symbolBudget": 11,
          "disposition": "retain",
          "stability": "supported",
          "guidance": "Canonical Vireo theme factory, semantic tokens, and light/dark foundations for ordinary applications."
        },
        "./storybook": {
          "audience": "authoring-tooling",
          "environment": ["browser"],
          "symbolBudget": 5,
          "disposition": "extract-next-major",
          "stability": "deprecated",
          "guidance": "Legacy Storybook authoring helpers; do not add application runtime dependencies on this subpath.",
          "migration": "Keep equivalent helpers application-owned until a separate authoring package is available."
        },
        "./storybook/VireoDockedSidePanel": {
          "audience": "authoring-tooling",
          "environment": ["browser"],
          "symbolBudget": 2,
          "disposition": "extract-next-major",
          "stability": "deprecated",
          "guidance": "Legacy Storybook-only workspace frame; not an application API.",
          "migration": "Copy the small authoring frame into local Storybook code if customization is required."
        },
        "./storybook/VireoIconContainer": {
          "audience": "authoring-tooling",
          "environment": ["browser"],
          "symbolBudget": 2,
          "disposition": "extract-next-major",
          "stability": "deprecated",
          "guidance": "Legacy Storybook-only icon comparison frame; not an application API.",
          "migration": "Copy the small authoring frame into local Storybook code if customization is required."
        },
        "./storybook/VireoResponsiveOverlayFrame": {
          "audience": "authoring-tooling",
          "environment": ["browser"],
          "symbolBudget": 4,
          "disposition": "extract-next-major",
          "stability": "deprecated",
          "guidance": "Legacy Storybook-only responsive overlay frame; not an application API.",
          "migration": "Copy the small authoring frame into local Storybook code if customization is required."
        }
      }
    }
  },
  "maven": {
    "com.vireocode:vireo-core": {
      "audience": "application",
      "role": "server-foundation",
      "declarationBudget": 34,
      "packageIntents": {
        "com.vireocode.vireo.base": "domain-base-and-mapping-api",
        "com.vireocode.vireo.config": "spring-auto-configuration-api",
        "com.vireocode.vireo.flyway": "migration-extension-api",
        "com.vireocode.vireo.observability": "operational-observation-events",
        "com.vireocode.vireo.security": "security-expression-api",
        "com.vireocode.vireo.spi": "consumer-extension-points",
        "com.vireocode.vireo.web": "http-and-error-contracts"
      }
    },
    "com.vireocode:vireo-auth": {
      "audience": "application",
      "role": "default-authentication",
      "declarationBudget": 14,
      "packageIntents": { "com.vireocode.vireo.auth": "authentication-http-and-configuration-api" }
    },
    "com.vireocode:vireo-query": {
      "audience": "application",
      "role": "server-query-engine",
      "declarationBudget": 37,
      "packageIntents": { "com.vireocode.vireo.queryengine": "query-language-and-persistence-api" }
    },
    "com.vireocode:vireo-offline": {
      "audience": "application",
      "role": "offline-sync-server",
      "declarationBudget": 41,
      "packageIntents": { "com.vireocode.vireo.offline": "offline-protocol-and-persistence-api" }
    },
    "com.vireocode:vireo-history": {
      "audience": "application",
      "role": "server-history",
      "declarationBudget": 15,
      "packageIntents": { "com.vireocode.vireo.history": "history-recording-and-query-api" }
    },
    "com.vireocode:vireo-bom": { "audience": "build-tooling", "role": "version-alignment" }
  }
}
