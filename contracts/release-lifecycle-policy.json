{
  "schemaVersion": 1,
  "channels": {
    "stable": { "status": "active", "npmTag": "latest", "versionPattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "prerelease": {
      "status": "not-enabled",
      "npmTag": "next",
      "versionPattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-(?:alpha|beta|rc)\\.[0-9]+$",
      "mustNotReplaceStableCoordinates": true
    }
  },
  "supportLines": [
    {
      "id": "0.3-alpha",
      "status": "active",
      "release": "npm-0.8.7_jvm-0.4.0",
      "introducedOn": "2026-08-26",
      "statusEffectiveOn": "2026-08-30",
      "deprecatedOn": null,
      "eolOn": null,
      "maintenanceScope": "security-and-critical-correctness",
      "fixMaintenance": "latest-release-only",
      "upgradeSourceWindow": "prior-current-release",
      "replacement": "none",
      "compatibilityPolicy": "docs/COMPATIBILITY.md",
      "withdrawalGuide": "docs/RELEASE_LIFECYCLE.md"
    }
  ],
  "transitions": {
    "allowed": ["active->deprecated", "deprecated->eol"],
    "minimumDeprecationDays": 30,
    "requireReplacementOrExplicitNone": true
  }
}
