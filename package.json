{
  "name": "@vireocodedev/starter",
  "private": true,
  "version": "0.0.0",
  "description": "vireocodedev starter — shared frontend libraries. The backend libraries live in jvm/ and are built by Gradle.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": "12.0.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.15.0 <25",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "error"
    }
  },
  "scripts": {
    "ci:change-plan:test": "node --test scripts/ci-change-plan.test.mjs",
    "verify": "sh scripts/verify.sh",
    "verify:all": "sh scripts/verify-all.sh",
    "gate:fast": "node scripts/run-ecosystem-gate.mjs fast",
    "gate:full": "node scripts/run-ecosystem-gate.mjs full",
    "gate:release": "node scripts/run-ecosystem-gate.mjs release",
    "storybook": "sh scripts/with-declared-npm.sh npm run storybook --workspace=@vireocodedev/ui",
    "build-storybook": "sh scripts/with-declared-npm.sh npm run build-storybook --workspace=@vireocodedev/ui",
    "test:storybook": "sh scripts/with-declared-npm.sh npm run test:storybook --workspace=@vireocodedev/ui",
    "test:storybook:install": "sh scripts/with-declared-npm.sh npm exec -- playwright install --with-deps chromium",
    "docs:portal": "node scripts/build-documentation-portal.mjs",
    "docs:check": "node scripts/documentation-policy.mjs",
    "docs:check:artifact": "node scripts/documentation-policy.mjs --artifact",
    "site:build": "node site/build.mjs",
    "site:snapshot": "node site/generate-snapshot.mjs --write",
    "site:dev": "node site/dev.mjs",
    "site:check": "node site/verify.mjs",
    "site:check:artifact": "node site/verify.mjs --artifact",
    "site:test": "node --test site/build.test.mjs",
    "site:deploy:vps": "sh site/deploy-vps.sh",
    "site:stage:vps": "sh site/stage-vps-bootstrap.sh",
    "build-docs": "corepack npm run build && corepack npm run build-storybook && ./jvm/gradlew -p jvm aggregateJavadoc && corepack npm run docs:portal && corepack npm run docs:check:artifact",
    "build": "sh scripts/with-declared-npm.sh turbo run build",
    "dev": "sh scripts/with-declared-npm.sh turbo run dev",
    "typecheck": "sh scripts/with-declared-npm.sh turbo run typecheck --concurrency=5",
    "test": "sh scripts/with-declared-npm.sh sh scripts/test.sh",
    "test:architecture": "node --test scripts/lib/module-graph.test.mjs scripts/ui-architecture.test.mjs && node scripts/ui-architecture.mjs && node scripts/ui-loading-contracts.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "api:inventory": "node scripts/api-inventory.mjs",
    "api:policy": "node scripts/public-api-policy.mjs",
    "surface": "node scripts/public-surface.mjs",
    "surface:update": "node scripts/public-surface.mjs --update",
    "types:strict": "node scripts/strict-consumer-types.mjs",
    "generate": "node scripts/generate.mjs",
    "generate:test": "corepack npm run projection:check && node --test scripts/generator/*.test.mjs",
    "projection:check": "node scripts/application-projection-policy.mjs && node --test scripts/application-projection-policy.test.mjs",
    "codex:check": "node scripts/codex-customization-policy.mjs",
    "codex:test": "node --test --test-concurrency=1 scripts/codex-customization-policy.test.mjs scripts/codex-consumer-skills.test.mjs",
    "codex:adopt": "node scripts/codex-consumer-skills.mjs",
    "generate:entity:fixture": "corepack npm run build && node scripts/generated-entity-fixture.mjs",
    "generate:frontend:fixture": "corepack npm run build && node scripts/generated-frontend-fixture.mjs",
    "upgrade:project:fixture": "corepack npm run build && node scripts/project-upgrade-fixture.mjs",
    "upgrade:project:baselines": "node scripts/check-project-upgrade-baselines.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "release-impact:check": "node scripts/release-impact-policy.mjs",
    "release-impact:test": "node --test scripts/release-impact-policy.test.mjs scripts/release-impact-version.test.mjs",
    "release:automation:test": "node --test scripts/ecosystem-publication-plan.test.mjs scripts/maven-central-release-state.test.mjs scripts/maven-recovery-source-run.test.mjs scripts/release-run-artifacts.test.mjs scripts/prepare-jvm-only-release-trigger.test.mjs scripts/finalize-jvm-release.test.mjs scripts/finalize-npm-releases.test.mjs scripts/template-publication-eligibility.test.mjs scripts/publish-verified-npm-candidates.test.mjs scripts/report-npm-publication-result.test.mjs scripts/release-workflow-activity.test.mjs scripts/maven-central-publication.test.mjs scripts/workflow-security-policy.test.mjs",
    "release:lifecycle:check": "node --test scripts/release-lifecycle-policy.test.mjs && node scripts/release-lifecycle-policy.mjs",
    "version:jvm-impact": "node scripts/release-impact-version.mjs",
    "version-packages": "node scripts/changeset-version-adapter.mjs",
    "release:smoke": "node scripts/release-pack-smoke.mjs",
    "release:validate": "node scripts/validate-npm-release.mjs",
    "release:publish-candidates": "node scripts/publish-verified-npm-candidates.mjs .release-evidence",
    "release:report-publication": "node scripts/report-npm-publication-result.mjs .release-evidence/npm-publication-result.json",
    "template:adoption:plan": "node scripts/plan-template-adoption.mjs --json",
    "template:adoption:stage": "node scripts/stage-template-adoption.mjs",
    "release:template-auto-plan": "node scripts/npm-template-adoption-publication-plan.mjs",
    "release:verify-public": "node scripts/verify-npm-public-release.mjs",
    "consumer:gauntlet": "node scripts/anonymous-consumer-gauntlet.mjs",
    "consumer:gauntlet:check": "node scripts/anonymous-consumer-gauntlet.mjs --check",
    "release:evidence": "node scripts/generate-release-evidence.mjs .release-evidence",
    "license:check": "node scripts/third-party-license-policy.mjs",
    "license:check:npm": "node scripts/third-party-license-policy.mjs --ecosystem npm",
    "license:check:jvm": "node scripts/third-party-license-policy.mjs --ecosystem jvm",
    "license:test": "node --test scripts/third-party-license-policy.test.mjs",
    "release:collect-public-evidence": "node scripts/collect-public-release-evidence.mjs .public-release-evidence",
    "release:sbom:check": "node --test scripts/release-sbom-evidence.test.mjs",
    "peer-floor:check": "node scripts/peer-floor-consumer.mjs",
    "public:audit": "sh scripts/public-repository-audit.sh",
    "ecosystem:check": "node --test scripts/ecosystem-contract-policy.test.mjs && node scripts/ecosystem-contract-policy.mjs",
    "identity:check": "node --test scripts/product-identity-policy.test.mjs && node scripts/product-identity-policy.mjs",
    "public:check": "node scripts/ecosystem-contract-policy.mjs && corepack npm run release:lifecycle:check && corepack npm run release:sbom:check && node scripts/product-identity-policy.mjs && node scripts/public-contract-policy.mjs && node scripts/repository-security-policy.mjs && corepack npm run consumer:gauntlet:check && node scripts/documentation-policy.mjs && node site/verify.mjs && node scripts/public-beta-evidence.mjs && corepack npm run beta:engineering:check",
    "beta:evidence:check": "node scripts/public-beta-evidence.mjs",
    "beta:engineering:check": "node scripts/public-beta-engineering-readiness.mjs && node --test scripts/public-beta-engineering-readiness.test.mjs",
    "security:secrets": "sh scripts/secret-scan.sh",
    "security:workflow": "node scripts/workflow-security-policy.mjs",
    "security:repository": "node scripts/repository-security-policy.mjs",
    "toolchain:check": "node scripts/toolchain-policy.mjs && node scripts/platform-support-policy.mjs && node --test scripts/platform-support-policy.test.mjs",
    "release": "sh scripts/with-declared-npm.sh sh -c 'corepack npm run verify -- silent && corepack npm run release:publish'",
    "release:publish": "sh scripts/with-declared-npm.sh node scripts/changeset-publish-adapter.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/browser-playwright": "4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "esbuild": "^0.28.2",
    "globals": "^17.11.0",
    "parse5": "^8.0.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "saxes": "6.0.0",
    "storybook": "^10.5.10",
    "turbo": "^2.10.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "npm@12.0.2"
}
