{
  "name": "@vireocodedev/shell",
  "version": "0.2.2",
  "description": "Framework-free Vireo contracts for application sitemaps, navigation, auth redirects, and overlay history.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vireocodedev/vireo.git",
    "directory": "packages/shell"
  },
  "homepage": "https://vireocode.com/reference/typescript/",
  "bugs": {
    "url": "https://github.com/vireocodedev/vireo/issues"
  },
  "keywords": [
    "shell",
    "navigation",
    "sitemap",
    "routing",
    "starter"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch --mode watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "zod": ">=4.4 <5"
  },
  "devDependencies": {
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^5.0.0",
    "zod": "^4.5.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  }
}
