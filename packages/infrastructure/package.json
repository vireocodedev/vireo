{
  "name": "@vireocodedev/infrastructure",
  "version": "0.3.0",
  "description": "React-free Vireo browser infrastructure for validated HTTP transport, connectivity, persistence, and execution modes.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vireocodedev/vireo.git",
    "directory": "packages/infrastructure"
  },
  "homepage": "https://vireocode.com/reference/typescript/",
  "bugs": {
    "url": "https://github.com/vireocodedev/vireo/issues"
  },
  "keywords": [
    "infrastructure",
    "network-status",
    "signals",
    "http",
    "starter"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./network-status": {
      "types": "./dist/network/appNetworkStatus.d.ts",
      "import": "./dist/network/appNetworkStatus.js"
    },
    "./pagination": {
      "types": "./dist/http/pagination.d.ts",
      "import": "./dist/http/pagination.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch --mode watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@preact/signals-core": ">=1.8",
    "axios": ">=1.7",
    "zod": ">=4.4 <5"
  },
  "devDependencies": {
    "@preact/signals-core": "^1.14.4",
    "axios": "^1.20.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  }
}
