{
  "name": "create-vireo",
  "version": "0.8.7",
  "description": "Create a production-shaped Vireo Framework React application, with an optional Spring Boot backend, from the pinned Starter Template.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vireocodedev/vireo.git",
    "directory": "packages/create-vireo"
  },
  "homepage": "https://vireocode.com/reference/typescript/",
  "bugs": {
    "url": "https://github.com/vireocodedev/vireo/issues"
  },
  "keywords": [
    "create",
    "vireo",
    "react",
    "frontend",
    "spring-boot",
    "starter"
  ],
  "bin": {
    "create-vireo": "./dist/cli.js",
    "vireo": "./dist/vireo-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "corepack npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "prettier": "^3.9.6"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "esbuild": "^0.28.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  }
}
