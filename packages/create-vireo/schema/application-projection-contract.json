{
  "schemaVersion": 1,
  "contractId": "vireo-application-projection",
  "description": "Authoritative ownership and projection policy for projects created from the pinned Vireo Template.",
  "categories": {
    "maintainer-only": {
      "projectDisposition": "exclude",
      "description": "Vireo flagship operations, evidence, maintainer governance, and profile-inapplicable source that must never be copied into an application."
    },
    "managed": {
      "projectDisposition": "copy-managed",
      "description": "Framework integration infrastructure copied with provenance and updated through Vireo upgrade tooling."
    },
    "application-owned": {
      "projectDisposition": "copy-ejectable",
      "description": "Application code and policy copied once, then owned and reviewed by the generated project."
    },
    "optional": {
      "projectDisposition": "copy-when-selected",
      "description": "Examples, editor conveniences, or capabilities emitted only when their profile or option is selected."
    },
    "substitution-required": {
      "projectDisposition": "render",
      "description": "Public identity or project metadata that must be rendered from explicit creation inputs and resolved before release."
    },
    "historical": {
      "projectDisposition": "exclude",
      "description": "Dated engineering evidence retained by Vireo but not shipped as current application guidance."
    }
  },
  "identity": {
    "metadataPath": ".vireo/project.json",
    "unresolvedMarkerPrefix": "UNRESOLVED_VIREO_",
    "fields": [
      {
        "name": "projectName",
        "source": "creation-input",
        "requiredBy": "creation",
        "format": "kebab-case"
      },
      {
        "name": "displayName",
        "source": "creation-input-or-derived",
        "requiredBy": "creation",
        "format": "non-empty"
      },
      {
        "name": "ownerName",
        "source": "creation-input",
        "requiredBy": "release",
        "format": "non-empty",
        "unresolvedMarker": "UNRESOLVED_VIREO_OWNER_NAME"
      },
      {
        "name": "repositoryUrl",
        "source": "creation-input",
        "requiredBy": "release",
        "format": "https-url",
        "unresolvedMarker": "UNRESOLVED_VIREO_REPOSITORY_URL"
      },
      {
        "name": "supportUrl",
        "source": "creation-input",
        "requiredBy": "release",
        "format": "https-or-mailto-url",
        "unresolvedMarker": "UNRESOLVED_VIREO_SUPPORT_URL"
      },
      {
        "name": "securityContact",
        "source": "creation-input",
        "requiredBy": "release",
        "format": "https-or-mailto-url",
        "unresolvedMarker": "UNRESOLVED_VIREO_SECURITY_CONTACT"
      }
    ],
    "releaseRequirements": {
      "rejectUnresolvedMarkers": true,
      "requireApplicationOwner": true,
      "requireApplicationRepository": true,
      "requireDistinctSupportAndSecurityRoutes": true,
      "forbiddenInheritedHosts": [
        "github.com/vireocodedev/starter",
        "github.com/vireocodedev/starter-template",
        "github.com/vireocodedev/vireo",
        "github.com/vireocodedev/vireo-template"
      ]
    }
  },
  "profiles": ["full-stack", "frontend"],
  "defaultOptionalRuleIds": [
    "selected-common-examples-and-tools",
    "full-stack-selected-editor-tools",
    "full-stack-selected-demo-and-e2e",
    "full-stack-selected-guidance",
    "full-stack-dependabot"
  ],
