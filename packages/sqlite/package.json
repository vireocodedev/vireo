{
  "name": "@vireocodedev/sqlite",
  "version": "0.2.3",
  "description": "Reusable Vireo SQLite worker and client runtime primitives for browser persistence and offline workflows.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vireocodedev/vireo.git",
    "directory": "packages/sqlite"
  },
  "homepage": "https://vireocode.com/reference/typescript/",
  "bugs": {
    "url": "https://github.com/vireocodedev/vireo/issues"
  },
  "keywords": [
    "sqlite",
    "opfs",
    "worker",
    "runtime",
    "starter"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./offline": {
      "types": "./dist/offline/index.d.ts",
      "import": "./dist/offline/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch --mode watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@sqlite.org/sqlite-wasm": ">=3.53.0-build1"
  },
  "devDependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "jsdom": "^30.0.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  }
}
